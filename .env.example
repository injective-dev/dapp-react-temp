# ============================================================
# Injective dApp Template — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ------------------------------------------------------------
# Frontend (Vite) — prefix with VITE_ to expose to browser
# ------------------------------------------------------------

# Injective EVM Testnet
VITE_CHAIN_ID=1440002
VITE_RPC_URL=https://testnet.svm.injective.network/
VITE_EXPLORER_URL=https://testnet.blockscout.injective.network/

# WalletConnect Project ID (get one at https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Official Circle USDC on Injective Testnet (pre-filled — do not change for testnet)
# Source: https://docs.injective.network/developers-defi/usdc-stablecoin#testnet
VITE_USDC_ADDRESS=0x0C382e685bbeeFE5d3d9C29e29E341fEE8E84C5d

# USDCPaymentProcessor — fill in after running: cd contracts && npm run deploy:testnet
VITE_PAYMENT_PROCESSOR_ADDRESS=

# ------------------------------------------------------------
# Contracts (Hardhat) — NOT exposed to browser
# ------------------------------------------------------------

# Your deployer private key (NEVER commit this!)
PRIVATE_KEY=your_private_key_here

# Injective testnet RPC
INJECTIVE_TESTNET_RPC=https://testnet.svm.injective.network/

# ============================================================
# Mainnet config (when ready to go live)
# ============================================================
# VITE_CHAIN_ID=1738
# VITE_RPC_URL=https://svm.injective.network/
# VITE_EXPLORER_URL=https://blockscout.injective.network/
# VITE_USDC_ADDRESS=0xa00C59fF5a080D2b954d0c75e46E22a0c371235a
