# ============================================================
# Injective dApp Template — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ------------------------------------------------------------
# Frontend (Vite) — prefix with VITE_ to expose to browser
# ------------------------------------------------------------

# Injective EVM Testnet (default)
VITE_CHAIN_ID=1440002
VITE_RPC_URL=https://testnet.svm.injective.network/
VITE_EXPLORER_URL=https://testnet.explorer.injective.network/

# WalletConnect Project ID (get one at https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Contract addresses — fill these in after running deploy:testnet
VITE_MOCK_USDC_ADDRESS=
VITE_PAYMENT_PROCESSOR_ADDRESS=

# ------------------------------------------------------------
# Contracts (Hardhat) — NOT exposed to browser
# ------------------------------------------------------------

# Your deployer private key (NEVER commit this!)
PRIVATE_KEY=your_private_key_here

# Injective testnet RPC (same as above but for Hardhat)
INJECTIVE_TESTNET_RPC=https://testnet.svm.injective.network/

# ============================================================
# Mainnet config (when ready to go live)
# Uncomment and update VITE_CHAIN_ID to 1738
# ============================================================
# VITE_CHAIN_ID=1738
# VITE_RPC_URL=https://svm.injective.network/
# VITE_EXPLORER_URL=https://explorer.injective.network/
