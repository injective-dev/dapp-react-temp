# ============================================================
# Injective dApp Template — Environment Variables
# ============================================================

# --- Frontend (Vite) ---

# Injective EVM Testnet
VITE_CHAIN_ID=1439
VITE_RPC_URL=https://k8s.testnet.json-rpc.injective.network/
VITE_EXPLORER_URL=https://testnet.blockscout.injective.network/

# WalletConnect Project ID (https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_project_id

# Official Circle USDC on Injective Testnet (pre-filled)
VITE_USDC_ADDRESS=0x0C382e685bbeeFE5d3d9C29e29E341fEE8E84C5d

# Fill in after: cd contracts && npm run deploy:testnet
VITE_PAYMENT_PROCESSOR_ADDRESS=

# --- Contracts (Hardhat) ---

# Deployer private key (never commit this!)
PRIVATE_KEY=your_private_key_here
INJECTIVE_TESTNET_RPC=https://k8s.testnet.json-rpc.injective.network/

# ============================================================
# Mainnet — uncomment when going live
# ============================================================
# VITE_CHAIN_ID=1776
# VITE_RPC_URL=https://sentry.evm-rpc.injective.network/
# VITE_EXPLORER_URL=https://blockscout.injective.network/
# VITE_USDC_ADDRESS=0xa00C59fF5a080D2b954d0c75e46E22a0c371235a
